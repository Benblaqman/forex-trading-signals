# Application
APP_NAME=ForexSignalApp
APP_ENV=development
DEBUG=True

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/forex_signals_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Forex Data API
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_API_KEY=your_oanda_api_key

# M-Pesa / Daraja Integration
DARIJA_CONSUMER_KEY=your_consumer_key
DARIJA_CONSUMER_SECRET=your_consumer_secret
DARIJA_SHORTCODE=your_shortcode
DARIJA_PASSKEY=your_passkey
DARIJA_CALLBACK_URL=https://yourdomain.com/api/v1/mpesa/callback
DARIJA_ENVIRONMENT=sandbox  # or production

# JWT / Authentication
SECRET_KEY=your_super_secret_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS Configuration (for alerts)
SMS_PROVIDER=africastalking  # or twilio
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Data Retention
CHECKPOINT_DAYS=30
SIGNAL_HISTORY_DAYS=365

# Risk Management (defaults)
DEFAULT_POSITION_SIZE_PERCENT=2.0
DEFAULT_STOP_LOSS_PIPS=50
DEFAULT_RISK_REWARD_RATIO=2.0
